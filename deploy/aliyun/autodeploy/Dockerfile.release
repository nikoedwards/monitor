# syntax=docker/dockerfile:1

# The frontend is validated and built by GitHub Actions. Reusing that dist/
# avoids repeating npm install on the production host.
ARG BASE_IMAGE=python:3.12-slim@sha256:5b8b1421ccb6a525860a77863c049eab5847076cda34e030c75a80c58faf3f3c
ARG REUSE_RUNTIME=0
FROM ${BASE_IMAGE} AS runtime
ARG REUSE_RUNTIME
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOST=0.0.0.0 \
    PORT=8790

COPY requirements.txt /tmp/monitor-requirements.txt
RUN set -eux; \
    apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*; \
    set -eux; \
    if [ "$REUSE_RUNTIME" = "1" ] \
      && python -m pip install --no-index --no-deps -r /tmp/monitor-requirements.txt \
      && python -c 'import playwright' \
      && test -d /ms-playwright; then \
      echo "Reusing cached Monitor runtime dependencies"; \
    else \
      python -m pip install --no-cache-dir -r /tmp/monitor-requirements.txt \
      && python -m pip install --no-cache-dir "playwright>=1.50,<2" \
      && python -m playwright install --with-deps chromium; \
    fi

RUN rm -rf /app/server /app/browser_extensions /app/dist \
    && mkdir -p /app/data
COPY server ./server
COPY browser_extensions ./browser_extensions
COPY dist ./dist

EXPOSE 8790
CMD ["python", "-m", "server.app"]
