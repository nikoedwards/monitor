# syntax=docker/dockerfile:1

# The frontend is validated and built by GitHub Actions. Reusing that dist/
# avoids repeating npm install on the production host.
FROM python:3.12-slim@sha256:5b8b1421ccb6a525860a77863c049eab5847076cda34e030c75a80c58faf3f3c
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOST=0.0.0.0 \
    PORT=8790

COPY requirements.txt /tmp/monitor-requirements.txt
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir -r /tmp/monitor-requirements.txt \
    && python -m pip install --no-cache-dir "playwright>=1.50,<2" \
    && python -m playwright install --with-deps chromium \
    && mkdir -p /app/data

COPY server ./server
COPY browser_extensions ./browser_extensions
COPY dist ./dist

EXPOSE 8790
CMD ["python", "-m", "server.app"]
