# Runtime defaults
MONITOR_SCHEDULER=1
MONITOR_SCHEDULER_SECONDS=3600
MONITOR_CRAWL_LIMIT=20

# Optional LLM integration. The default endpoint is shown in server/ai.py;
# set these only if you want AI summaries or snapshot analysis.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_APP_TITLE=monitor-hub
LLM_MAX_TOKENS=4096

# Optional connector credentials. Leave blank when unused.
YOUTUBE_API_KEY=
ENSEMBLEDATA_TOKEN=
REDDIT_BEARER_TOKEN=
REDDIT_USER_AGENT=MonitorIntelligenceHub/1.0 (+brand intelligence monitor)
DISCORD_BOT_TOKEN=
FACEBOOK_ACCESS_TOKEN=
META_ACCESS_TOKEN=
KEEPA_API_KEY=
SELLERSPRITE_SECRET_KEY=

# Optional Caddy proxy settings. Set this to a DNS name, then start the
# proxy profile: docker compose --profile proxy up -d
DOMAIN=monitor.example.com

# Leave the app bound to localhost when using Caddy. For direct access set
# APP_BIND_ADDRESS=0.0.0.0 and optionally change APP_PORT.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8790
